@@ -0,0 +1,42 @@
+import type { JSONContent } from '@tiptap/core';
+import { bridgeFrom, type HangulFormat, type HangulArtifact } from '../rhwpWorkbench';
+import { tiptapToHwpx, type HwpxConversionOptions } from '../conversion/tiptapToHwpx';
+
+export async function buildHangul(doc: JSONContent, format: HangulFormat, options: HwpxConversionOptions): Promise<HangulArtifact> {
+    const frame = document.createElement('iframe');
+    frame.title = '한글 파일 변환';
+    frame.setAttribute('aria-hidden', 'true');
+    frame.inert = true;
+    frame.tabIndex = -1;
+    frame.style.cssText = 'position:fixed;left:-20000px;top:0;width:1200px;height:900px;border:0;';
+    let timer: ReturnType<typeof setTimeout>;
+    const timeout = new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error('한글 변환 엔진 준비 시간이 초과되었습니다.')), 60000);
+    });
+    try {
+        const loaded = new Promise<void>((resolve, reject) => {
+            frame.onload = () => resolve();
+            frame.onerror = () => reject(new Error('한글 변환 엔진을 불러오지 못했습니다.'));
+        });
+        frame.src = new URL('./rhwp/index.html?chrome=embed', document.baseURI).href;
+        document.body.append(frame);
+        return await Promise.race([timeout, (async () => {
+            await loaded;
+            const bridge = bridgeFrom(frame);
+            await bridge.ready;
+            await bridge.create();
+            const blank = bridge.export('hwpx');
+            const converted = tiptapToHwpx(doc, blank.bytes, options);
+            if (converted.warnings.length) {
+                throw new Error('현재 한글 변환에서 보존하지 못하는 항목이 있어 저장을 중단했습니다.\n• ' + converted.warnings.join('\n• '));
+            }
+            await bridge.open(converted.bytes, 'converted.hwpx');
+            const result = bridge.export(format);
+            if (result.contentLoss.count) throw new Error('한글 내보내기에 내용 손실이 있어 저장을 중단했습니다.');
