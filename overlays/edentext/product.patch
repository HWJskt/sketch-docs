+import type { JSONContent } from '@tiptap/core';
+import { strFromU8, strToU8, unzipSync, zipSync, type Zippable } from 'fflate';
+import { HEADING_STYLE_OVERRIDES } from '../styles/headings';
+
+export interface HwpxConversionOptions {
+  pageWidthMm?: number;
+  pageHeightMm?: number;
+  marginsMm?: { top: number; bottom: number; left: number; right: number };
+}
+export interface HwpxConversionResult { bytes: Uint8Array; warnings: string[] }
+const HP = 'http://www.hancom.co.kr/hwpml/2011/paragraph';
+const HH = 'http://www.hancom.co.kr/hwpml/2011/head';
+const all = (root: Document | Element, name: string) => Array.from(root.getElementsByTagNameNS('*', name));
+const first = (root: Document | Element, name: string) => all(root, name)[0];
+const units = (mm: number) => Math.round(mm * 7200 / 25.4);
+
+/** Builds a new single-section document; the supplied package must be a fresh engine template. */
+export function tiptapToHwpx(doc: JSONContent, blankHwpx: Uint8Array, options: HwpxConversionOptions = {}): HwpxConversionResult {
+  if (doc.type !== 'doc') throw new Error('HWPX 변환에는 TipTap 문서가 필요합니다.');
+  const files = unzipSync(blankHwpx);
+  const parse = (path: string) => {
+    if (!files[path]) throw new Error(`HWPX 템플릿에 ${path} 파일이 없습니다.`);
+    const xml = new DOMParser().parseFromString(strFromU8(files[path]), 'application/xml');
+    if (first(xml, 'parsererror')) throw new Error(`HWPX 템플릿 XML 오류: ${path}`);
+    return xml;
+  };
+  if (Object.keys(files).filter(p => /^Contents\/section\d+\.xml$/.test(p)).length !== 1) {
+    throw new Error('HWPX 템플릿은 하나의 구역이어야 합니다.');
+  }
+  const section = parse('Contents/section0.xml');
+  const header = parse('Contents/header.xml');
+  const secPr = first(section, 'secPr')?.cloneNode(true) as Element | undefined;
+  const colPr = first(section, 'colPr')?.cloneNode(true) as Element | undefined;
+  const charBase = first(header, 'charPr');
+  const paraBase = first(header, 'paraPr');
+  const borderBase = first(header, 'borderFill');
+  if (!secPr || !charBase || !paraBase || !borderBase) throw new Error('HWPX 템플릿의 기본 서식이 없습니다.');
+  const warnings = new Set<string>();
+  const warn = (message: string) => warnings.add(message);
+  const attrs = (node: JSONContent, supported: string[]) => {
+    for (const [key, value] of Object.entries(node.attrs || {})) {
+      if (key === 'styleName' && (['Normal', 'Standard'].includes(String(value)) || (node.type === 'heading' && /^Heading(?:_20_| )?\d+$/.test(String(value))))) continue;
+      if (['minWidth', 'minHeight', 'width', 'height', 'indent', 'hangingIndent', 'marginLeft', 'marginRight', 'marginTop', 'marginBottom'].includes(key) && value === 0) continue;
+      if (Array.isArray(value) && !value.length) continue;
+      if (value !== null && value !== undefined && value !== '' && value !== false && !supported.includes(key)) {
+        warn(`${node.type}.${key}: 이 속성은 HWPX에 반영되지 않습니다.`);
+      }
+    }
+  };
+  const el = (name: string, values: Record<string, string | number> = {}, owner = section) => {
+    const e = owner.createElementNS(name.startsWith('hh:') ? HH : HP, name);
+    for (const [key, value] of Object.entries(values)) e.setAttribute(key, String(value));
+    return e;
+  };
+  const addDefinition = (base: Element) => {
+    const parent = base.parentElement!;
+    const id = Math.max(...Array.from(parent.children).map(e => Number(e.getAttribute('id')) || 0)) + 1;
+    const copy = base.cloneNode(true) as Element;
+    copy.setAttribute('id', String(id));
+    parent.appendChild(copy);
+    parent.setAttribute('itemCnt', String(parent.children.length));
+    return copy;
+  };
+  const page = first(secPr, 'pagePr');
+  const margin = first(secPr, 'margin');
+  for (const [key, value] of [['width', options.pageWidthMm ?? 210], ['height', options.pageHeightMm ?? 297]] as const) {
+    if (!Number.isFinite(value) || value <= 0) throw new Error('용지 크기가 올바르지 않습니다.');
+    page?.setAttribute(key, String(units(value)));
+  }
+  for (const [key, value] of Object.entries(options.marginsMm ?? { top: 20, bottom: 20, left: 20, right: 20 })) {
+    if (!Number.isFinite(value) || value < 0) throw new Error('용지 여백이 올바르지 않습니다.');
+    margin?.setAttribute(key, String(units(value)));
+  }
+  margin?.setAttribute('header', '0');
+  margin?.setAttribute('footer', '0');
+  const bodyWidth = Number(page?.getAttribute('width')) - Number(margin?.getAttribute('left')) - Number(margin?.getAttribute('right'));
+  const bodyHeight = Number(page?.getAttribute('height')) - Number(margin?.getAttribute('top')) - Number(margin?.getAttribute('bottom'));
+  if (!(bodyHeight > 0)) throw new Error('용지 높이보다 여백이 큽니다.');
+  if (!(bodyWidth > 0)) throw new Error('용지 폭보다 여백이 큽니다.');
+  const charCache = new Map<string, string>();
+  const paraCache = new Map<string, string>();
+  let serial = 1;
+  function charId(node: JSONContent, heading = 0): string {
+    const style = HEADING_STYLE_OVERRIDES[heading - 1];
+    let size = style ? parseFloat(style.fontSize) : 12;
+    let bold = !!style, italic = !!style?.italic, underline = false, strike = false;
+    let color = '#000000';
+    let family = heading ? 'Arial' : 'Liberation Serif';
+    for (const mark of node.marks || []) {
+      if (mark.type === 'bold') bold = true;
+      else if (mark.type === 'italic') italic = true;
+      else if (mark.type === 'underline') underline = true;
+      else if (mark.type === 'strike') strike = true;
+      else if (mark.type === 'textStyle') {
+        attrs(mark, ['fontSize', 'color', 'fontFamily']);
+        if (mark.attrs?.fontFamily) family = String(mark.attrs.fontFamily).split(',')[0].trim().replace(/^['"]|['"]$/g, '');
+        if (mark.attrs?.fontSize) {
+          const match = String(mark.attrs.fontSize).match(/^(\d+(?:\.\d+)?)(pt|px)?$/);
+          if (match && Number(match[1]) > 0) size = Number(match[1]) * (match[2] === 'px' ? 0.75 : 1);
+          else warn('textStyle.fontSize: 지원하지 않는 글자 크기입니다.');
+        }
+        if (mark.attrs?.color) {
+          const c = String(mark.attrs.color);
+          if (/^#[\da-f]{6}$/i.test(c)) color = c;
+          else if (/^#[\da-f]{3}$/i.test(c)) color = '#' + [...c.slice(1)].map(x => x + x).join('');
+          else warn('textStyle.color: 지원하지 않는 색상 표현입니다.');
+        }
+      } else warn(`${mark.type}: 이 글자 서식은 HWPX에 반영되지 않습니다.`);
+    }
+    const key = JSON.stringify([size, bold, italic, underline, strike, color, family]);
+    const cached = charCache.get(key);
+    if (cached) return cached;
+    const cp = addDefinition(charBase);
+    cp.setAttribute('height', String(Math.round(size * 100)));
+    cp.setAttribute('textColor', color);
+    const fontRef = first(cp, 'fontRef');
+    for (const face of all(header, 'fontface')) {
+      let font = Array.from(face.children).find(f => f.getAttribute('face') === family);
+      if (!font && face.firstElementChild) {
+        font = face.firstElementChild.cloneNode(true) as Element;
+        font.setAttribute('id', String(Math.max(...Array.from(face.children).map(f => Number(f.getAttribute('id')) || 0)) + 1));
+        font.setAttribute('face', family);
+        face.appendChild(font);
+        face.setAttribute('fontCnt', String(face.children.length));
+      }
+      if (font) fontRef?.setAttribute((face.getAttribute('lang') || '').toLowerCase(), font.getAttribute('id')!);
+    }
+    for (const name of ['bold', 'italic']) for (const child of all(cp, name)) child.remove();
+    const anchor = first(cp, 'underline');
+    if (italic) cp.insertBefore(el('hh:italic', {}, header), anchor || null);
+    if (bold) cp.insertBefore(el('hh:bold', {}, header), anchor || null);
+    first(cp, 'underline')?.setAttribute('type', underline ? 'BOTTOM' : 'NONE');
+    first(cp, 'strikeout')?.setAttribute('shape', strike ? 'SOLID' : 'NONE');
+    const id = cp.getAttribute('id')!;
+    charCache.set(key, id);
+    return id;
+  }
+  function paraId(node: JSONContent): string {
+    const align = node.attrs?.textAlign || 'left';
+    const supported = ['left', 'center', 'right', 'justify'];
+    if (!supported.includes(align)) warn(`문단 정렬 ${align}: 왼쪽 정렬로 변환됩니다.`);
+    const horizontal = supported.includes(align) ? align : 'left';
+    const level = node.type === 'heading' ? Number(node.attrs?.level || 1) : 0;
+    const key = `${horizontal}:${level}`;
+    if (paraCache.has(key)) return paraCache.get(key)!;
+    const pp = addDefinition(paraBase);
+    first(pp, 'align')?.setAttribute('horizontal', horizontal.toUpperCase());
+    for (const e of all(pp, 'lineSpacing')) { e.setAttribute('type', 'PERCENT'); e.setAttribute('value', '100'); }
+    for (const m of all(pp, 'margin')) for (const c of Array.from(m.children)) c.setAttribute('value', '0');
+    const headingStyle = HEADING_STYLE_OVERRIDES[level - 1];
+    if (headingStyle) {
+      for (const m of all(pp, 'margin')) {
+        first(m, 'prev')?.setAttribute('value', String(units(parseFloat(headingStyle.marginTop) * 10)));
+        first(m, 'next')?.setAttribute('value', String(units(parseFloat(headingStyle.marginBottom) * 10)));
+      }
+      first(pp, 'breakSetting')?.setAttribute('keepWithNext', '1');
+    }
+    const id = pp.getAttribute('id')!;
+    paraCache.set(key, id);
+    return id;
+  }
+  function paragraph(node: JSONContent): Element {
+    attrs(node, ['textAlign', 'level']);
+    const heading = node.type === 'heading' ? Number(node.attrs?.level || 1) : 0;
+    if (heading && !HEADING_STYLE_OVERRIDES[heading - 1]) warn('지원하지 않는 제목 수준입니다.');
+    const p = el('hp:p', { id: serial++, paraPrIDRef: paraId(node), styleIDRef: 0, pageBreak: 0, columnBreak: 0, merged: 0 });
+    if (heading) {
+      const styles = first(header, 'styles');
+      const name = `Heading ${heading}`;
+      let style = styles && Array.from(styles.children).find(e => e.getAttribute('engName') === name && e.getAttribute('paraPrIDRef') === p.getAttribute('paraPrIDRef'));
+      if (!style && styles?.firstElementChild) {
+        style = addDefinition(styles.firstElementChild);
+        style.setAttribute('type', 'PARA');
+        style.setAttribute('name', name); style.setAttribute('engName', name);
+        style.setAttribute('paraPrIDRef', p.getAttribute('paraPrIDRef')!);
+        style.setAttribute('charPrIDRef', charId({}, heading));
+      }
+      if (style) p.setAttribute('styleIDRef', style.getAttribute('id')!);
+      else warn('제목 스타일을 생성할 수 없어 직접 서식으로 변환됩니다.');
+    }
+    function inline(n: JSONContent) {
+      if (n.type === 'text' || n.type === 'hardBreak') {
+        const run = el('hp:run', { charPrIDRef: charId(n, heading) });
+        const t = el('hp:t');
+        if (n.type === 'hardBreak') t.appendChild(el('hp:lineBreak'));
+        else t.textContent = n.text || '';
+        run.appendChild(t); p.appendChild(run);
+      } else {
+        warn(`${n.type}: 지원하지 않는 요소입니다. 포함된 텍스트만 유지됩니다.`);
+        for (const c of n.content || []) inline(c);
+      }
+    }
+    for (const child of node.content || []) inline(child);
+    if (!p.children.length) inline({ type: 'text', text: '' });
+    return p;
+  }
+  const tableBorder = addDefinition(borderBase);
+  for (const side of ['leftBorder', 'rightBorder', 'topBorder', 'bottomBorder']) first(tableBorder, side)?.setAttribute('type', 'SOLID');
+  function table(node: JSONContent): Element {
+    attrs(node, []);
+    const rows = node.content || [];
+    // Editor row heights are CSS pixels at 96 dpi; HWP uses 7200 units/inch.
+    const heights = rows.map(row => {
+      const height = row.attrs?.rowHeight;
+      if (height == null || height === 0) return 2800;
+      if (typeof height !== 'number' || !Number.isFinite(height) || height < 0) throw new Error('표의 행 높이가 올바르지 않습니다.');
+      return Math.max(1, Math.round(height * 75));
+    });
+    const occupied: boolean[][] = rows.map(() => []);
+    const placements: { node: JSONContent; row: number; col: number; rs: number; cs: number }[] = [];
+    let cols = 0;
+    rows.forEach((row, r) => {
+      attrs(row, ['rowHeight']);
+      let c = 0;
+      for (const cell of row.content || []) {
+        attrs(cell, ['colspan', 'rowspan', 'colwidth']);
+        while (occupied[r][c]) c++;
+        const cs = Number(cell.attrs?.colspan ?? 1), rs = Number(cell.attrs?.rowspan ?? 1);
+        if (!Number.isInteger(cs) || cs < 1 || cs > 1000 || !Number.isInteger(rs) || rs < 1 || r + rs > rows.length) throw new Error('표의 병합 범위가 올바르지 않습니다.');
+        for (let y = r; y < r + rs; y++) for (let x = c; x < c + cs; x++) {
+          if (occupied[y][x]) throw new Error('표의 병합 범위가 겹칩니다.');
+          occupied[y][x] = true;
+        }
+        placements.push({ node: cell, row: r, col: c, rs, cs }); c += cs; cols = Math.max(cols, c);
+      }
+    });
+    if (!cols || !rows.length || occupied.some(row => Array.from({ length: cols }, (_, i) => row[i]).some(v => !v))) throw new Error('표의 행과 열 구조가 올바르지 않습니다.');
+    // As in the editor, the first row defines proportional column widths.
+    const weights: (number | null)[] = [];
+    for (const cell of placements) {
+      const widths = cell.node.attrs?.colwidth;
+      if (widths != null && (!Array.isArray(widths) || widths.length !== cell.cs || widths.some(w => w != null && (typeof w !== 'number' || !Number.isFinite(w) || w < 0)))) {
+        throw new Error('표의 열 너비가 올바르지 않습니다.');
+      }
+      if (cell.row === 0) for (let k = 0; k < cell.cs; k++) weights.push(widths?.[k] || null);
+    }
+    const present = weights.filter((w): w is number => w != null);
+    const average = present.length ? present.reduce((a, b) => a + b, 0) / present.length : 1;
+    const filled = weights.map(w => w ?? average);
+    const total = filled.reduce((a, b) => a + b, 0);
+    const edges = [0];
+    let cumulative = 0;
+    for (const weight of filled) { cumulative += weight; edges.push(Math.round(bodyWidth * cumulative / total)); }
+    const p = paragraph({ type: 'paragraph' });
+    const run = p.firstElementChild!;
+    const tbl = el('hp:tbl', { id: serial++, zOrder: 0, numberingType: 'TABLE', textWrap: 'TOP_AND_BOTTOM', textFlow: 'BOTH_SIDES', lock: 0, dropcapstyle: 'None', pageBreak: 'CELL', repeatHeader: 0, rowCnt: rows.length, colCnt: cols, cellSpacing: 0, borderFillIDRef: tableBorder.getAttribute('id')!, noAdjust: 0 });
+    tbl.appendChild(el('hp:sz', { width: bodyWidth, widthRelTo: 'ABSOLUTE', height: heights.reduce((a, b) => a + b, 0), heightRelTo: 'ABSOLUTE', protect: 0 }));
+    tbl.appendChild(el('hp:pos', { treatAsChar: 1, affectLSpacing: 0, flowWithText: 1, allowOverlap: 0, holdAnchorAndSO: 0, vertRelTo: 'PARA', horzRelTo: 'COLUMN', vertAlign: 'TOP', horzAlign: 'LEFT', vertOffset: 0, horzOffset: 0 }));
+    for (const n of ['outMargin', 'inMargin']) tbl.appendChild(el(`hp:${n}`, { left: 0, right: 0, top: 0, bottom: 0 }));
+    rows.forEach((_, r) => {
+      const tr = el('hp:tr'); tbl.appendChild(tr);
+      for (const cell of placements.filter(c => c.row === r)) {
+        const tc = el('hp:tc', { name: '', header: cell.node.type === 'tableHeader' ? 1 : 0, hasMargin: 1, protect: 0, editable: 0, dirty: 0, borderFillIDRef: tableBorder.getAttribute('id')! });
+        const list = el('hp:subList', { id: '', textDirection: 'HORIZONTAL', lineWrap: 'BREAK', vertAlign: 'CENTER', linkListIDRef: 0, linkListNextIDRef: 0, textWidth: 0, textHeight: 0, hasTextRef: 0, hasNumRef: 0 });
+        for (const child of blocks(cell.node.content || [])) list.appendChild(child);
+        tc.appendChild(list);
+        tc.appendChild(el('hp:cellAddr', { colAddr: cell.col, rowAddr: r }));
+        tc.appendChild(el('hp:cellSpan', { colSpan: cell.cs, rowSpan: cell.rs }));
+        tc.appendChild(el('hp:cellSz', { width: edges[cell.col + cell.cs] - edges[cell.col], height: heights.slice(r, r + cell.rs).reduce((a, b) => a + b, 0) }));
+        tc.appendChild(el('hp:cellMargin', { left: 141, right: 141, top: 141, bottom: 141 }));
+        tr.appendChild(tc);
+      }
+    });
+    run.insertBefore(tbl, run.firstChild);
+    return p;
+  }
+  function blocks(nodes: JSONContent[]): Element[] {
+    const out: Element[] = [];
+    for (const node of nodes) {
+      if (node.type === 'paragraph' || node.type === 'heading') out.push(paragraph(node));
+      else if (node.type === 'table') out.push(table(node));
+      else {
+        warn(`${node.type}: 지원하지 않는 요소입니다. 포함된 텍스트만 유지됩니다.`);
+        if (node.content?.length) out.push(...blocks(node.content));
+        else if (node.text) out.push(paragraph({ type: 'paragraph', content: [node] }));
+      }
+    }
+    return out.length ? out : [paragraph({ type: 'paragraph' })];
+  }
+  attrs(doc, []);
+  const body = blocks(doc.content || []);
+  section.documentElement.replaceChildren(...body);
+  const firstRun = body[0].firstElementChild!;
+  firstRun.insertBefore(secPr, firstRun.firstChild);
+  if (colPr) { const ctrl = el('hp:ctrl'); ctrl.appendChild(colPr); firstRun.insertBefore(ctrl, secPr.nextSibling); }
+  const serializer = new XMLSerializer();
+  files['Contents/section0.xml'] = strToU8(serializer.serializeToString(section));
+  files['Contents/header.xml'] = strToU8(serializer.serializeToString(header));
+  files['Preview/PrvText.txt'] = strToU8(all(section, 't').map(e => e.textContent).join('\n'));
+  const archive: Zippable = { mimetype: [files.mimetype || strToU8('application/hwp+zip'), { level: 0 }] };
+  for (const [name, bytes] of Object.entries(files)) if (name !== 'mimetype') archive[name] = bytes;
+  return { bytes: zipSync(archive), warnings: [...warnings] };
+}
