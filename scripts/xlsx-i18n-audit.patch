+
+/// Sketch Docs measurement build only (scripts/xlsx-i18n-audit): each label asked for that has no
+/// translation is logged once, so the runner can list what the interface still shows in English.
+fn audit_miss(text: &str) {
+    thread_local! { static SEEN: std::cell::RefCell<std::collections::BTreeSet<String>> = std::cell::RefCell::default(); }
+    SEEN.with(|seen| {
+        if seen.borrow_mut().insert(text.to_string()) {
+            log::warn!("i18n-miss\t{text}");
+        }
+    });
+}
