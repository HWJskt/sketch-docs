{
  "name": "edentext-word-hwp",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/HWJskt/sketch-docs.git"
  },
  "type": "module",
  "scripts": {
    "upstream:sync": "node scripts/upstreams.mjs sync",
    "upstream:check": "node scripts/upstreams.mjs candidate",
    "upstream:promote": "node scripts/upstreams.mjs promote",
    "prepare:engines": "node scripts/build-engines.mjs",
    "predev": "npm run prepare:engines",
    "dev": "vite --host localhost",
    "build": "npm run prepare:engines && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --config ./svelte.config.js",
    "test:contracts": "node --test tests/contracts.test.mjs tests/upstream-git.test.mjs tests/release-info.test.mjs tests/service-worker.test.mjs tests/engine-manifest.test.mjs tests/engine-preload.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:regressions": "node tests/regressions.mjs",
    "test:live": "LIVE_ORIGIN=${LIVE_ORIGIN:-https://docs.sketchps.app} node tests/regressions.mjs",
    "verify": "node scripts/verify.mjs",
    "mirrors:pin": "node scripts/mirrors.mjs pin",
    "mirrors:check": "node scripts/mirrors.mjs check",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@noble/hashes": "2.4.0",
    "canvaskit-wasm": "0.42.0",
    "fflate": "0.8.2",
    "svelte": "5.57.1",
    "svelte-pdf-mini": "0.9.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "playwright-core": "1.62.1",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "wrangler": "4.142.0"
  },
  "volta": {
    "node": "24.21.0"
  },
  "engines": {
    "node": ">=24"
  }
}
